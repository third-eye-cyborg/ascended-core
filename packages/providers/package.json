{
  "name": "@third-eye-cyborg/providers",
  "version": "0.2.0",
  "description": "Provider ports (auth, storage, email, push, payments, search, rate limiting, audit) plus generic in-memory adapters for tests and examples.",
  "author": "Third Eye Cyborg, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/third-eye-cyborg/ascended-core.git",
    "directory": "packages/providers"
  },
  "homepage": "https://github.com/third-eye-cyborg/ascended-core#readme",
  "bugs": {
    "url": "https://github.com/third-eye-cyborg/ascended-core/issues"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@third-eye-cyborg/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "ascended-core",
    "third-eye-cyborg",
    "typescript",
    "community",
    "adapters"
  ]
}
