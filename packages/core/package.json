{
  "name": "@third-eye-cyborg/core",
  "version": "0.1.1",
  "description": "Shared foundation types for Ascended Core: identity, errors, results, lifecycle, and health.",
  "author": "Third Eye Cyborg LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/third-eye-cyborg/ascended-core.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/third-eye-cyborg/ascended-core#readme",
  "bugs": {
    "url": "https://github.com/third-eye-cyborg/ascended-core/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
