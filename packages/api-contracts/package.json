{
  "name": "@third-eye-cyborg/api-contracts",
  "version": "0.1.0",
  "description": "Public-safe OpenAPI contract for the reference API plus generated Zod validation types and a drift check.",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@third-eye-cyborg/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "spec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
