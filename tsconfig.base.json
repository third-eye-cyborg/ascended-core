{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@third-eye-cyborg/ai-router": [
        "./packages/ai-router/src/index.ts"
      ],
      "@third-eye-cyborg/api-contracts": [
        "./packages/api-contracts/src/index.ts"
      ],
      "@third-eye-cyborg/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@third-eye-cyborg/core": [
        "./packages/core/src/index.ts"
      ],
      "@third-eye-cyborg/events": [
        "./packages/events/src/index.ts"
      ],
      "@third-eye-cyborg/media": [
        "./packages/media/src/index.ts"
      ],
      "@third-eye-cyborg/notifications": [
        "./packages/notifications/src/index.ts"
      ],
      "@third-eye-cyborg/observability": [
        "./packages/observability/src/index.ts"
      ],
      "@third-eye-cyborg/persistence": [
        "./packages/persistence/src/index.ts"
      ],
      "@third-eye-cyborg/privacy": [
        "./packages/privacy/src/index.ts"
      ],
      "@third-eye-cyborg/providers": [
        "./packages/providers/src/index.ts"
      ],
      "@third-eye-cyborg/realtime": [
        "./packages/realtime/src/index.ts"
      ],
      "@third-eye-cyborg/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@third-eye-cyborg/example-minimal-server": [
        "./examples/minimal-server/src/index.ts"
      ],
      "@third-eye-cyborg/example-openapi-client": [
        "./examples/openapi-client/src/index.ts"
      ],
      "@third-eye-cyborg/example-reference-adapters": [
        "./examples/reference-adapters/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
