{
  "name": "@third-eye-cyborg/ascended-example-reference-adapters",
  "version": "0.1.0",
  "description": "Synthetic local adapter implementations wired end-to-end for demos and integration tests.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@third-eye-cyborg/ascended-core": "workspace:*",
    "@third-eye-cyborg/ascended-contracts": "workspace:*",
    "@third-eye-cyborg/ascended-events": "workspace:*",
    "@third-eye-cyborg/ascended-providers": "workspace:*",
    "@third-eye-cyborg/ascended-persistence": "workspace:*",
    "@third-eye-cyborg/ascended-realtime": "workspace:*",
    "@third-eye-cyborg/ascended-media": "workspace:*",
    "@third-eye-cyborg/ascended-notifications": "workspace:*",
    "@third-eye-cyborg/ascended-observability": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  },
  "private": true
}
