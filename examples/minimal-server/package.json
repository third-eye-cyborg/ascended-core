{
  "name": "@third-eye-cyborg/ascended-example-minimal-server",
  "version": "0.1.0",
  "description": "Runnable reference server demonstrating profiles, posts, communities, events, and notifications on local adapters.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "clean": "rm -rf dist coverage",
    "start": "tsx src/server.ts",
    "smoke": "tsx tests/smoke.ts"
  },
  "dependencies": {
    "@third-eye-cyborg/ascended-core": "workspace:*",
    "@third-eye-cyborg/ascended-contracts": "workspace:*",
    "@third-eye-cyborg/ascended-events": "workspace:*",
    "@third-eye-cyborg/ascended-privacy": "workspace:*",
    "@third-eye-cyborg/ascended-ai-router": "workspace:*",
    "@third-eye-cyborg/ascended-providers": "workspace:*",
    "@third-eye-cyborg/ascended-persistence": "workspace:*",
    "@third-eye-cyborg/ascended-realtime": "workspace:*",
    "@third-eye-cyborg/ascended-media": "workspace:*",
    "@third-eye-cyborg/ascended-notifications": "workspace:*",
    "@third-eye-cyborg/ascended-observability": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  },
  "private": true
}
