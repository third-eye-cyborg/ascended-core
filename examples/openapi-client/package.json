{
  "name": "@third-eye-cyborg/ascended-example-openapi-client",
  "version": "0.1.0",
  "description": "Example client consuming the generated SDK against the minimal server.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
