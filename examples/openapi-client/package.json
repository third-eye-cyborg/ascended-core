  },
  "dependencies": {
    "@third-eye-cyborg/ascended-core": "workspace:*",
    "@third-eye-cyborg/ascended-example-minimal-server": "workspace:*",
    "@third-eye-cyborg/ascended-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  },
  "private": true
}
